@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-secondary">Thonipho Mavhungu | ST10121100</span>
            <button class="btn btn-sm btn-outline-primary ms-3" @onclick="ToggleHelp" aria-expanded="@showHelp">
                How to use
            </button>
        </div>

        <article class="content px-4">
            @if (showHelp)
            {
                <section class="help-panel mb-4" aria-label="How to use Smart-X">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h5">How to use Smart-X Part 1</h2>
                            <ol class="mb-0 ps-3">
                                <li>Open <strong>Telemetry</strong> from the gateway.</li>
                                <li>Register a sensor using its device ID, MAC address, location and category.</li>
                                <li>Review proactive alerts first, then select <strong>Investigate</strong> to open the affected sensor history.</li>
                                <li>Choose a sensor and filter by a metric to reduce the readings displayed.</li>
                                <li>Select a reading to view its exact value, source device and timestamp.</li>
                            </ol>
                        </div>
                        <button class="btn-close" aria-label="Close help" @onclick="ToggleHelp"></button>
                    </div>
                </section>
            }
            @Body
        </article>
    </main>
</div>

@code {
    private bool showHelp;

    private void ToggleHelp()
    {
        showHelp = !showHelp;
    }
}
