@page "/telemetry"
@inject SmartX.Client.Services.SensorApiClient SensorApi

<PageTitle>Telemetry Workspace</PageTitle>

<div class="py-4">
    <p class="text-uppercase text-primary fw-semibold mb-2">Part 1 workspace</p>
    <h1>Sensor Data Ingestion and Telemetry</h1>
    <p class="lead text-secondary">
        Register a sensor before sending its telemetry to Smart-X.
    </p>

    @if (message is not null)
    {
        <div class="alert @messageStyle" role="alert">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <section class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h4">Register a sensor</h2>
                    <EditForm Model="newSensor" OnSubmit="RegisterSensorAsync">
                        <div class="mb-3">
                            <label class="form-label" for="deviceId">Device ID</label>
                            <InputText id="deviceId" class="form-control" @bind-Value="newSensor.DeviceId" placeholder="SENSOR-001" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="macAddress">MAC address</label>
                            <InputText id="macAddress" class="form-control" @bind-Value="newSensor.MacAddress" placeholder="AA:BB:CC:DD:EE:FF" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="location">Deployment location</label>
                            <InputText id="location" class="form-control" @bind-Value="newSensor.DeploymentLocation" placeholder="Hydroponic Farm A - Zone 1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="category">Category</label>
                            <InputSelect id="category" class="form-select" @bind-Value="newSensor.Category">
                                @foreach (var category in Enum.GetValues<SensorCategory>())
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <button class="btn btn-primary" type="submit">Register sensor</button>
                    </EditForm>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h4 mb-0">Registered sensors</h2>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSensorsAsync">Refresh</button>
                    </div>

                    @if (registeredSensors.Count == 0)
                    {
                        <p class="text-secondary mb-0">No sensors have been registered yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Device ID</th>
                                        <th>Location</th>
                                        <th>Category</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sensor in registeredSensors)
                                    {
                                        <tr>
                                            <td>@sensor.DeviceId</td>
                                            <td>@sensor.DeploymentLocation</td>
                                            <td>@sensor.Category</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <NavLink class="btn btn-link px-0 mt-4" href="">Back to gateway</NavLink>
</div>

@code {
    private SensorProfile newSensor = new();
    private List<SensorProfile> registeredSensors = [];
    private string? message;
    private string messageStyle = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
    }

    private async Task LoadSensorsAsync()
    {
        try
        {
            registeredSensors = await SensorApi.GetSensorsAsync();
        }
        catch (HttpRequestException)
        {
            message = "The API is not running. Start SmartX.Api, then refresh this page.";
            messageStyle = "alert-warning";
        }
    }

    private async Task RegisterSensorAsync()
    {
        try
        {
            var response = await SensorApi.RegisterSensorAsync(newSensor);

            if (!response.IsSuccessStatusCode)
            {
                message = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "This device ID or MAC address is already registered."
                    : "Please enter a device ID, MAC address and deployment location.";
                messageStyle = "alert-danger";
                return;
            }

            message = $"{newSensor.DeviceId} was registered successfully.";
            messageStyle = "alert-success";
            newSensor = new SensorProfile();
            await LoadSensorsAsync();
        }
        catch (HttpRequestException)
        {
            message = "The API is not running. Start SmartX.Api, then try again.";
            messageStyle = "alert-warning";
        }
    }
}
